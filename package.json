{
  "name": "@ar-js-org/ar.js-next",
  "version": "0.2.1",
  "description": "core library of AR.js",
  "main": "dist/arjs-core.js",
  "module": "dist/arjs-core.mjs",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "import": "./dist/arjs-core.mjs",
      "require": "./dist/arjs-core.js",
      "default": "./dist/arjs-core.mjs"
    }
  },
  "types": "types/src/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:vite && npm run build:types",
    "build:types": "tsc",
    "build:vite": "vite build",
    "dev:vite": "vite",
    "format-check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js",
    "prepare": "husky install && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc -p tests/typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AR-js-org/AR.js-next.git"
  },
  "keywords": [
    "AR.js",
    "WebAR",
    "AugmentedReality"
  ],
  "author": "@kalwalt",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --cache"
    ]
  },
  "files": [
    "dist",
    "src",
    "plugins",
    "types",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/AR-js-org/AR.js-next#readme",
  "bugs": {
    "url": "https://github.com/AR-js-org/AR.js-next/issues"
  }
}
